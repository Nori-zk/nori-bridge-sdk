{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "./src",
    "typeRoots": ["../node_modules/@types"],
    "paths": {
      "o1js": ["../node_modules/o1js"],
      "*": ["./*", "./src/*", "../node_modules/*"]
    }
  },
  "exclude": ["../node_modules", "node_modules", "build", "**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
