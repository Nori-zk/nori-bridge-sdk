# Full configuration for `npm run deploy`.
# Values marked (pre-deploy) are generated by `npm run pre-deploy`.
# Values marked (optional) can be omitted.

# Ethereum =================================================================
# Deployer/operator private key (bare hex, no 0x prefix)
ETH_PRIVATE_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# JSON-RPC endpoint
ETH_RPC_URL=https://ethereum-sepolia.core.chainstack.com/abc123
# Network label: hardhat, sepolia, mainnet, hoodi
ETH_NETWORK=sepolia

# Aligned layer (pre-deploy) ================================================
# AlignedLayer service manager contract address for the target Ethereum network.
# Fetched from https://github.com/yetanotherco/aligned_layer
ALIGNED_ETH_SERVICE_MANAGER_ADDRESS=0xFf731AB7b3653dc66878DC77E851D174f472d137

# Bridge operator (optional) ================================================
# Safe address or EOA; defaults to deployer if unset
NORI_ETH_BRIDGE_OPERATOR_ADDRESS=0xC7e910807Dd2E3F49b34EFe7133cfb684520dA69

# Mina zkApp tokenID (required) =============================================
# 32-byte hex of the Mina NoriStorage zkApp tokenID. Set as an immutable on
# the bridge at deployment.
NORI_ETH_BRIDGE_ZKAPP_TOKEN_ID=0x1b848805a3db129b6b41adca52c9b6f380d58dc9c283f73ce17466a01b90d361

# Mina zkApp verification key hash (required) ===============================
# keccak256 of the ABI-encoded NoriStorage zkApp verification key.
# Set as an immutable on the bridge at deployment.
NORI_ETH_BRIDGE_ZKAPP_VERIFICATION_KEY_HASH=0xdc9c283f73ce17466a01b90d36141b848805a3db129b6b80d581adca52c9b6f3

# Fee configuration (optional) ==============================================
# Treasury address; if provided, used as the initial feeRecipient at construction.
# Otherwise it can be configured later via setFeeRecipient.
NORI_ETH_BRIDGE_FEE_RECIPIENT_ADDRESS=0xC7e910807Dd2E3F49b34EFe7133cfb684520dA69
# Lock fee rate, 1 unit = 0.001%, e.g. 500 = 0.5%
NORI_ETH_BRIDGE_LOCK_FEE_RATE=500
# Unlock fee rate, 1 unit = 0.001%, e.g. 500 = 0.5%
NORI_ETH_BRIDGE_UNLOCK_FEE_RATE=500

# Proof request queue fee (optional) ========================================
# Flat fee charged per enqueued storage-proof request, in wei. Every lock
# enqueues exactly one request, so a depositor pays this fee plus the lock fee
# rate above. Must be a multiple of 10^12 wei, at most 5*10^16 wei (0.05 ETH).
# Defaults to 0, i.e. no per-request charge.
#
# That ceiling is emergency headroom, not a usable value: it sits well above
# the bridge's 0.001 ETH minimum deposit, and any fee at or near the minimum
# deposit makes small deposits revert with FeeExceedsLockAmount. Keep this
# comfortably below 0.001 ETH.
#
# The value below is 2*10^14 wei (0.0002 ETH). Run `npm run preview-fees` to
# see what any fee and rate combination costs a depositor at each deposit size.
# Adjustable after deploy via `npm run set-proof-request-queue-fee <eth>`.
NORI_ETH_BRIDGE_PROOF_REQUEST_QUEUE_FEE_WEI=200000000000000
