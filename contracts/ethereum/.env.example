ETH_PRIVATE_KEY=
ETH_RPC_URL=
ETH_NETWORK=
NORI_ETH_TOKEN_BRIDGE_TEST_MODE=true
NORI_ETH_TOKEN_BRIDGE_ADDRESS=<extract this from .env.nori-eth-token-bridge after running npm run deploy>
NORI_ETH_BRIDGE_OPERATOR_ADDRESS=<Safe address or EOA to serve as bridge operator; defaults to deployer if unset>
NORI_ETH_BRIDGE_FEE_RECIPIENT_ADDRESS=<treasury address for fee withdrawal; optional, can be set post-deploy>
NORI_ETH_BRIDGE_LOCK_FEE_RATE=<lock fee rate, 1 unit = 0.001%, e.g. 500 = 0.5%; optional>
NORI_ETH_BRIDGE_UNLOCK_FEE_RATE=<unlock fee rate, 1 unit = 0.001%, e.g. 500 = 0.5%; optional>