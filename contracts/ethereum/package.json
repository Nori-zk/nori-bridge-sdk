{
    "name": "@nori-zk/ethereum-token-bridge",
    "version": "0.0.12",
    "description": "NoriTokenBridge contract",
    "main": "build/index.js",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "type": "module",
    "scripts": {
        "build": "mkdir -p lib && (test -d lib/aligned_layer || git clone https://github.com/yetanotherco/aligned_layer --recursive lib/aligned_layer) && ETH_NETWORK=hardhat npm run clean && ETH_NETWORK=hardhat hardhat compile && node stabilize-types.mjs . && tsc -p tsconfig.package.json",
        "test": "ETH_NETWORK=hardhat hardhat test",
        "test-ci": "ETH_NETWORK=hardhat hardhat test",
        "clean": "hardhat clean",
        "format": "prettier --check --ignore-unknown **/*",
        "format:fix": "prettier --write --ignore-unknown **/*",
        "lint": "npx eslint tasks bin test *.ts",
        "lint:fix": "npx eslint tasks bin test *.ts --fix",
        "pre-deploy": "dotenv -e .env -- npx tsx bin/preDeploy.ts",
        "deploy": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK deploy'",
        "deploy-timelock": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK deployTimelock'",
        "test:lock": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK lockTokens \"$@\"' --",
        "test:lock-loop": "dotenv -e .env -- sh -c 'while true; do npx hardhat --network \"$ETH_NETWORK\" lockTokens \"$@\" || break; sleep 384; done' --",
        "get-deposited": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK getTotalDeposited \"$@\"' --",
        "get-fee-info": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK getFeeInfo'",
        "set-fee-rate": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK setFeeRate \"$@\"' --",
        "set-fee-recipient": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK setFeeRecipient \"$@\"' --",
        "withdraw-fees": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK withdrawFees'",
        "set-bridge-operator": "dotenv -e .env -- sh -c 'npx hardhat --network $ETH_NETWORK setBridgeOperator \"$@\"' --"
    },
    "author": "",
    "license": "MIT",
    "dependencies": {
        "esm-iso-logger": "1.0.2"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-ethers": "^4.0.1",
        "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
        "@nomicfoundation/hardhat-ignition": "^3.1.3",
        "@nomicfoundation/hardhat-ignition-ethers": "^3.1.4",
        "@nomicfoundation/hardhat-keystore": "^3.0.7",
        "@nomicfoundation/hardhat-mocha": "^3.0.17",
        "@nomicfoundation/hardhat-network-helpers": "^3.0.6",
        "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
        "@nomicfoundation/hardhat-typechain": "^3.0.0",
        "@nomicfoundation/hardhat-viem": "^3.0.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "^25.2.3",
        "chai": "^5.1.2",
        "dotenv": "^17.2.4",
        "dotenv-cli": "^8.0.0",
        "hardhat": "^3.1.11",
        "npm-workspaces-publish-tool": "0.0.17",
        "typechain": "^8.3.2"
    },
    "files": [
        "build/",
        "package.json",
        "README.md"
    ]
}
